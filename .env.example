APP_NAME="TPV Hostelería"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081
VITE_PORT=5174
# IP del ordenador en la LAN (HMR de Vite desde el móvil)
VITE_HMR_HOST=192.168.1.57

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Procesos del servidor de desarrollo (Filament carga muchos ficheros a la vez)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# Puerto de PostgreSQL publicado en el Mac (para un cliente SQL)
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum (SPA con cookies) ---
# Hosts desde los que la SPA usa sesión por cookie: localhost, 127.0.0.1 y la IP
# de este equipo en la LAN (con y sin puerto). En el mini PC: su IP fija.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8081,127.0.0.1,127.0.0.1:8081,192.168.1.57,192.168.1.57:8081

# --- Reverb (websockets) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Dónde escucha el servidor Reverb dentro de su contenedor
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Cómo llega Laravel (app y worker) a Reverb para publicar eventos:
# nombre del servicio Docker, no localhost.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Puerto publicado en el host (Docker)
FORWARD_REVERB_PORT=8080

# El navegador se conecta SIEMPRE a window.location.hostname; aquí solo van
# la clave, el puerto público y el esquema.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Impresora ESC/POS ---
# simulated: guarda la salida en storage/app/prints/ | real: impresión real (red o USB según la impresora)
PRINTER_MODE=simulated
PRINTER_HOST=192.168.1.200
PRINTER_PORT=9100
PRINTER_TIMEOUT=3
# Conexión de la configuración global (comando tpv:print-test): red | usb.
# Las impresoras de /admin tienen cada una su conexión.
PRINTER_CONNECTION=red
PRINTER_DEVICE=/dev/usb/lp0
PRINTER_PROFILE=default
# Tabla de caracteres (ESC t n). 16 = WPC1252 (á, ñ, €). Vacío = automático.
PRINTER_CODEPAGE=16
# 48 columnas en papel de 80 mm, 32 en 58 mm
PRINTER_COLUMNS=48
# Segundos que /admin espera el resultado de "Imprimir prueba" (va por la cola)
PRINTER_WEB_WAIT=5

# --- Admin de desarrollo (SOLO DESARROLLO, lo usa AdminUserSeeder) ---
DEV_ADMIN_EMAIL=admin@tpv.test
DEV_ADMIN_PASSWORD=admin1234

# --- Datos de demo (db:seed): bar | pizzeria ---
DEMO_DATASET=bar
