# .env de PRODUCCIÓN del mini PC (/opt/tpv/.env). Lo genera install.sh: las
# claves y contraseñas son únicas por instalación. No usar el .env de desarrollo.

# --- Imagen (GHCR privado o .tar cargado con docker load) ---
TPV_IMAGE=ghcr.io/CAMBIAR/tpv-hosteleria
TPV_VERSION=1.0.0
APP_HTTP_PORT=80

# --- App ---
APP_NAME="TPV Hostelería"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://192.168.1.10
APP_LAN_IP=192.168.1.10
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=Europe/Madrid
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Base de datos (contenedor pgsql) ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=tpv
DB_USERNAME=tpv
DB_PASSWORD=

# --- Sesión, caché y colas ---
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
# SPA con cookies: la red local (cualquier IP privada) y Tailscale (100.x y *.ts.net).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,192.168.*,10.*,172.16.*,100.*,*.ts.net

# --- Tiempo real (Reverb, detrás de FrankenPHP en /app) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Impresoras ---
PRINTER_MODE=real
PRINTER_TIMEOUT=3
PRINTER_WEB_WAIT=5

# --- Copias de seguridad (ver docs/instalacion-minipc.md) ---
# Clave PÚBLICA age (age1…): la privada NO está en este equipo.
BACKUP_AGE_RECIPIENT=
# Destino remoto (vacío = solo copias locales). Recomendado: en la UE (datos
# personales de clientes). Formato rclone "remoto:ruta"; el remoto "copias" se
# define con variables (descomenta uno de los dos bloques):
BACKUP_REMOTE=
# S3 compatible (p. ej. un proveedor europeo o MinIO):
#   BACKUP_REMOTE=copias:tpv-copias/nombre-del-local
#   RCLONE_CONFIG_COPIAS_TYPE=s3
#   RCLONE_CONFIG_COPIAS_PROVIDER=Other
#   RCLONE_CONFIG_COPIAS_ENDPOINT=https://s3.eu-central-1.example.com
#   RCLONE_CONFIG_COPIAS_ACCESS_KEY_ID=
#   RCLONE_CONFIG_COPIAS_SECRET_ACCESS_KEY=
# Tu servidor por SSH (clave en /app/storage/app/private/ssh/id_ed25519):
#   BACKUP_REMOTE=copias:/srv/copias/nombre-del-local
#   RCLONE_CONFIG_COPIAS_TYPE=sftp
#   RCLONE_CONFIG_COPIAS_HOST=copias.example.com
#   RCLONE_CONFIG_COPIAS_USER=tpv
#   RCLONE_CONFIG_COPIAS_KEY_FILE=/app/storage/app/private/ssh/id_ed25519
