# Une el equipo a Tailscale con la clave de /admin (ver /usr/local/sbin/tpv-tailscale-join).
# Root solo para `tailscale up`; la carpeta compartida se usa como el usuario de la app.
[Unit]
Description=TPV: unir el equipo a Tailscale con la clave de /admin
After=network-online.target tailscaled.service
Wants=network-online.target
# Sin límite de arranques: si se alcanzara, tpv-tailscale.path quedaría «failed» y ya no
# recogería más claves hasta reiniciar. No hay bucle: la clave se borra siempre al empezar.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tpv-tailscale-join
# /run/tpv-tailscale (700, root): la copia de la clave para tailscale; systemd la borra al terminar.
RuntimeDirectory=tpv-tailscale
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=150
# Endurecimiento (systemd-analyze security): sistema de solo lectura salvo la carpeta
# compartida; root solo conserva lo que necesita setpriv para bajar al usuario de la app.
ProtectSystem=strict
ReadWritePaths=/opt/tpv/host/tailscale
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
SystemCallArchitectures=native
# @system-service incluye lo que usa setpriv para bajar al usuario de la app.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
