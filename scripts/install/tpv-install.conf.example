# Valores para una instalación automática:  sudo bash install.sh --config tpv-install.conf
# Todo es opcional: sin este fichero, install.sh instala un cliente real con la imagen
# construida aquí, la IP detectada y el kiosko detectado. La empresa, el NIF, el régimen,
# las impresoras, las copias, Tailscale y VERI*FACTU se configuran después en /admin.

# cliente (por defecto) o demo
TPV_MODE="cliente"
# Solo en demo: bar | pizzeria | pizzeria_mixta
DEMO_DATASET="pizzeria_mixta"

# Nombre provisional del local (se cambia en /admin → Puesta en marcha)
LOCAL_NAME="Mi local"

# IP fija del mini PC (vacío = la detectada; resérvala en el router por su MAC)
LAN_IP=""

# Imagen: vacío = construirla aquí con el código copiado. Con token, se descarga de GHCR.
GHCR_TOKEN=""
GHCR_USER=""
TPV_IMAGE="ghcr.io/CAMBIAR/tpv-hosteleria"
TPV_VERSION=""

# Kiosko: auto (detecta el escritorio), si (forzar modo escritorio) o no (cage en tty1)
TPV_DESKTOP="auto"
